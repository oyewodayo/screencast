{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "binaries/ffmpeg/*",
      "binaries/heif/*",
      "binaries/whisper/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "productName": "Briefcast",
  "mainBinaryName": "Briefcast",
  "version": "0.0.0",
  "identifier": "com.briefscan.app",
  "plugins": {},
  "app": {
    "security": {
      "assetProtocol": {
        "scope": [
          "**"
        ],
        "enable": true
      },
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost data:; media-src 'self' asset: http://asset.localhost https://asset.localhost blob:; frame-src 'self' asset: http://asset.localhost https://asset.localhost; connect-src ipc: http://ipc.localhost 'self' asset: http://asset.localhost https://asset.localhost; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "title": "Briefcast",
        "width": 900,
        "height": 600,
        "minWidth": 850,
        "minHeight": 600,
        "visible": false
      },
      {
        "label": "recording-overlay",
        "title": "Recording",
        "url": "/recording-overlay",
        "width": 350,
        "height": 100,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "focus": false
      },
      {
        "label": "screenshot-overlay",
        "title": "Screenshot",
        "url": "/screenshot-overlay",
        "width": 300,
        "height": 120,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "focus": false
      }
    ]
  }
}