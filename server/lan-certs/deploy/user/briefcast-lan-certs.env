# /home/briefcastlan/briefcast-lan-certs.env - read by briefcast-lan-certs.service

# The zone Cloudflare delegates to this server: NS lan -> ns-lan.briefcast.space (A, DNS only).
LAN_ZONE=lan.briefcast.space
LAN_NS_HOST=ns-lan.briefcast.space
# SOA contact mailbox in DNS form (hostmaster.briefcast.space = hostmaster@briefcast.space).
LAN_SOA_MAILBOX=hostmaster.briefcast.space

# The public address, not 0.0.0.0 - systemd-resolved already holds 127.0.0.53:53.
LAN_DNS_BIND=169.58.69.201:53
# Only the Cloudflare Tunnel on this machine reaches the API.
LAN_API_BIND=127.0.0.1:8787
LAN_TRUST_PROXY=true

LAN_DATA_DIR=/home/briefcastlan/data

# "staging" (untrusted test certificates) until a full issuance works, then "production".
LAN_ACME=production
LAN_ACME_CONTACT=mailto:withbriefs@gmail.com
LAN_WEEKLY_CAP=45

RUST_LOG=info
