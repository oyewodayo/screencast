[Unit]
Description=Briefcast LAN certificates (DNS + ACME for phone transfer HTTPS)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/briefcast-lan-certs.env
ExecStart=/usr/local/bin/briefcast-lan-certs
Restart=always
RestartSec=3

# Unprivileged, but allowed to bind port 53.
DynamicUser=yes
StateDirectory=briefcast-lan-certs
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
