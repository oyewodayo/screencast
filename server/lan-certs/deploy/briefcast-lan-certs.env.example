# /etc/briefcast-lan-certs.env - read by briefcast-lan-certs.service

# The zone delegated to this server (see README: Cloudflare NS record).
LAN_ZONE=lan.withbriefs.com
# The name Cloudflare's NS record points at; must have an A record (DNS only, grey cloud) to this VPS.
LAN_NS_HOST=ns-lan.withbriefs.com
# SOA contact mailbox in DNS form (hostmaster.withbriefs.com = hostmaster@withbriefs.com).
LAN_SOA_MAILBOX=hostmaster.withbriefs.com

# Bind DNS to the VPS's PUBLIC address, not 0.0.0.0 - systemd-resolved already holds 127.0.0.53:53
# and a wildcard bind would collide with it.
LAN_DNS_BIND=203.0.113.10:53
# The API is only reached through nginx.
LAN_API_BIND=127.0.0.1:8787
LAN_TRUST_PROXY=true

LAN_DATA_DIR=/var/lib/briefcast-lan-certs

# Start with "staging" (untrusted test certificates, generous limits) until a full issuance works,
# then switch to "production".
LAN_ACME=staging
LAN_ACME_CONTACT=mailto:oyewodayo@gmail.com
# New installs (first certificates) per rolling 7 days. Renewals are exempt and not counted.
# Let's Encrypt allows 50 per registered domain; raise this once they grant an increase.
LAN_WEEKLY_CAP=45

RUST_LOG=info
